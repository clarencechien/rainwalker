name = "rain-on-route"
main = "src/index.js"
compatibility_date = "2026-01-01"

# 每 10 分鐘抓一次（對齊雨量站 cadence；UTC，但對 10 分間隔無影響）
[triggers]
crons = ["*/10 * * * *"]

# R2：存放算好的 data.json
[[r2_buckets]]
binding = "BUCKET"
bucket_name = "rain-on-route"

# CWA 授權碼用 secret，不要寫在這個檔：
#   wrangler secret put CWA_KEY
